<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.14" />
  </ItemGroup>

  <!-- Ship the model files with `dotnet publish` so the deployed app can find them -->
  <ItemGroup>
    <None Update="models\*.onnx" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
